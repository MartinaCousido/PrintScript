<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Convenciones de código de PrintScript.

  No hay respuesta correcta, hay respuesta acordada: el valor está en que el código
  sea predecible, no en cuál de las opciones se eligió. Si una regla molesta más de
  lo que aporta, se discute y se saca de acá; lo que no se hace es ignorarla.

  EL REPARTO CON SPOTLESS: si el formateador lo decide, Checkstyle no opina.
  Desde que existe Spotless con google-java-format (variante AOSP), el formato lo
  escribe el formateador y no tiene sentido que además una regla lo reporte: sería
  definir el estilo en dos archivos que van a divergir. Checkstyle queda con lo que
  un formateador NO puede decidir: cómo se llaman las cosas y qué construcciones son
  un error probable.

  Se sacaron de acá, con la verificación al lado, porque google-java-format ya las
  escribe (probado con un archivo que las violaba todas):
    - NewlineAtEndOfFile y FileTabCharacter quedan igual, ver abajo por qué.
    - LineLength: el formateador corta en 100.
    - RegexpSingleline (espacios al final): los borra.
    - LeftCurly y RightCurly: coloca las llaves.
    - ModifierOrder: reordena "static public" a "public static".
    - OneStatementPerLine: parte "int a = 1; int b = 2;" en dos líneas.
    - WhitespaceAfter, WhitespaceAround, GenericWhitespace, NoWhitespaceBefore:
      normaliza todos los espacios.
    - RedundantImport y UnusedImports: los borra el paso removeUnusedImports.
    - Indentation nunca estuvo, y ahora tampoco hace falta: la indentación la
      escribe el formateador. No agregarla.

  AvoidStarImport SÍ se queda: se verificó que el formateador NO expande los
  imports con asterisco, así que es la única regla de imports que sigue haciendo
  falta.

  Deliberadamente NO están:
    - MissingSwitchDefault: el diseño usa switch exhaustivo sobre tipos sellados,
      justamente sin default, para que el compilador avise cuando aparece una
      variante nueva. Exigir default rompería ese mecanismo.
    - Javadoc*: la semántica de cada contrato queda fijada por sus tests.
    - MagicNumber: ruido en tablas de precedencia y en los tests.
-->
<module name="Checker">
    <property name="severity" value="error"/> <!-- cualquier incumplimiento de cualquier regla es un error, no un warning -->
    <property name="fileExtensions" value="java"/> <!-- solo se miran archivos java; los .kts, .yml, .md los formatea Spotless -->

    <!--
      Estas dos las cubre el formateador, pero se quedan como red para los archivos
      que todavía nadie tocó: el ratchet de Spotless solo formatea lo modificado,
      mientras que Checkstyle mira siempre los 90 archivos. Cuestan una línea.
    -->
    <module name="NewlineAtEndOfFile"/> <!-- todo archivo tiene que terminar con un salto de linea -->
    <module name="FileTabCharacter"> <!-- prohibido el carácter de tabulación -->
        <property name="eachLine" value="true"/> <!-- sin esto reporta solo la primera tabulación de cada archivo -->
    </module>

    <module name="TreeWalker">

        <!-- imports -->
        <module name="AvoidStarImport"/> <!-- nada de import java.util.* , obliga a que los imports sean explícitos -->

        <!-- nombres -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>
        <!--
          ConstantName no cubre los valores de un enum, y Checkstyle no tiene una
          regla dedicada para eso: sin esto, un Operator.modulo entra sin que nadie
          lo frene. Se resuelve con MatchXpath, que permite consultar el árbol
          directamente. El patrón es el mismo que usa ConstantName.
        -->
        <module name="MatchXpath">
            <property name="query" value="//ENUM_CONSTANT_DEF/IDENT[not(matches(@text, '^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$'))]"/>
            <message key="matchxpath.match" value="Los valores de un enum van en mayúsculas separadas por guion bajo"/>
        </module>

        <!-- forma del código: solo lo que el formateador NO decide -->
        <module name="NeedBraces"/> <!-- if, else, for, while, do siempre con llaves, aunque el cuerpo sea una línea. El formateador no las agrega -->
        <module name="UpperEll"/> <!-- 100L y no 100l, que se confunde con 1001. El formateador no toca los literales -->
        <module name="ArrayTypeStyle"/> <!-- los corchetes van pegados al tipo: String[] nombres -->

        <!-- errores probables -->
        <module name="EmptyStatement"/> <!-- un ';' suelto -->
        <module name="EqualsHashCode"/> <!-- si redefinís equals sin redefinir hashCode (o al revés), el objeto se rompe adentro de cualquier HashMap o HashSet -->
        <module name="SimplifyBooleanExpression"/> <!-- if (x == true) en vez de if (x) -->
        <module name="SimplifyBooleanReturn"/> <!-- if (x) { return true; } else { return false; } en vez de return x; -->
        <module name="StringLiteralEquality"/> <!-- comparar strings con == en vez de .equals() -->
        <module name="HideUtilityClassConstructor"/> <!-- una clase que solo tiene métodos estáticos no puede tener constructor público. Si nadie la va a instanciar, el constructor tiene que ser privado -->
        <module name="FallThrough"/>

    </module>
</module>
