# Formato del proyecto PrintScript.
# Si mañana cambia el estilo del formateador, este archivo cambia con él.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 4 espacios y 100 columnas es lo que impone googleJavaFormat().aosp().
[*.java]
indent_style = space
indent_size = 4
max_line_length = 100

#convención oficial de Kotlin
[*.kts]
indent_style = space
indent_size = 4

#convención de los formatos de config
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# para que checkstyle.xml y pmd no se desalineen
[*.xml]
indent_style = space
indent_size = 4

# --las últimas dos son excepciones deliberadas a la regla de [*]--

# El script del wrapper para Windows tiene que quedar en CRLF o deja de
# funcionar. Es la única excepción a la regla de saltos de línea de arriba.
[*.bat]
end_of_line = crlf

# En Markdown, dos espacios al final de una línea son un salto de línea
# intencional: recortarlos rompe el texto.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
